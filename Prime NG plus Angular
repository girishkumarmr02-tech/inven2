Then:


public void selectTableDropdownValue(
        String tableName,
        String columnName,
        String value) {

    By dropdown =
        getTableDropdown(tableName, columnName);

    WebElement element =
        webDriverCommonLibrary
            .explicitWaitVisibility(driver, dropdown);

